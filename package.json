{
  "name": "agy-board",
  "version": "0.1.0",
  "description": "Workspace-linked Kanban & Todo board plugin for Antigravity — find workspaces, dispatch/resume conversations, track subgoals, deliverables, hooks, and schedules.",
  "type": "module",
  "license": "MIT",
  "author": "Fona1347",
  "homepage": "https://github.com/Fona1347/agy-board#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fona1347/agy-board.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "agy-board": "./dist/cli.mjs"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "typecheck": "tsc --noEmit",
    "build:client": "vite build --config vite.config.ts",
    "build:server": "node scripts/build-runtime.mjs",
    "build": "npm run typecheck && npm run build:client && npm run build:server",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.18",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.4",
    "@vitejs/plugin-react": "^4.5.0",
    "esbuild": "^0.25.4",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  }
}
